@startuml overallClassDiagram

rectangle "Workout Planning & Tracking System" {
    class WorkoutPlan
    class Viewer
    class Session
    class Workout
    class User
    class SuggestionEngine
    class Planner
    class ProgressAnalyzer

    WorkoutPlan o-- Workout
    SuggestionEngine ..> WorkoutPlan
    Planner ..> Viewer
    Viewer --> WorkoutPlan
    Viewer --> Session
    ProgressAnalyzer o.. Viewer
    User *-- WorkoutPlan
}

@enduml
